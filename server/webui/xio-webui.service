[Unit]
Description=XIO WebUI — TLS-панель управления сервером XIO
Documentation=file:/opt/xio-webui/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/xio-webui
ExecStart=/usr/bin/python3 /opt/xio-webui/xio-webui.py --listen 127.0.0.1:10443
Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
UMask=0077
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# Минимальная изоляция: панель должна уметь вызывать systemctl и admin.py,
# поэтому без NoNewPrivileges=yes и без ProtectSystem=strict.
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# "ReadWritePaths=-path" (dash prefix) keeps the unit startable on hosts where a
# managed install does not exist yet: systemd otherwise fails with 226/NAMESPACE
# ("Failed to set up mount namespacing").
ReadWritePaths=/opt/xio-webui -/etc/xio-managed -/var/lib/xio-rivet -/etc/xio-cascade -/var/lib/xio-cascade
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_SYS_ADMIN
# AmbientCapabilities не нужны: сервис работает от root и слушает непривилегированный порт.

[Install]
WantedBy=multi-user.target
