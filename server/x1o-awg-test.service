[Unit]
Description=x1o AmneziaWG test endpoint (pinned Go v3.1.20260814)
After=network-online.target wg-quick@x1o0.service
Wants=network-online.target

[Service]
Type=simple
UMask=0077
Environment=LOG_LEVEL=error
Environment=GOMAXPROCS=2
Environment=WG_PROCESS_FOREGROUND=1
ExecStart=/opt/x1o/amneziawg-go -f x1oawg0
ExecStartPost=/usr/bin/python3 /usr/local/lib/x1o-test/configure-awg.py
ExecStopPost=/usr/bin/python3 /usr/local/lib/x1o-test/configure-awg.py down
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=20
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
PrivateTmp=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
