[Unit]
StartLimitIntervalSec=0
Description=XIO Cascade tunnel to the IPv6 exit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/xio-cascade-tunnel.sh
Restart=always
RestartSec=10
SyslogIdentifier=xio-cascade

[Install]
WantedBy=multi-user.target
